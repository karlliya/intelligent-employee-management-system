# Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASS=
DB_NAME=employee_management

# Server Configuration
PORT=5000
HOST=127.0.0.1
NODE_ENV=production
FRONTEND_URL=https://iems.example.com
CORS_ORIGIN=https://iems.example.com
DEV_OTP_FALLBACK=0

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-here-change-in-production

# Gmail SMTP Configuration (Required for OTP)
# 1. Generate App Password in Google Account:
#    - Visit: https://myaccount.google.com/apppasswords
#    - Enable 2-Step Verification, then create an App Password for IEMS
#    - Use the generated 16-character App Password as GMAIL_PASSWORD
#    - Do not use your normal Google account password
# Real user accounts need reachable email addresses, not @iems.local.
# DEV_OTP_FALLBACK=1 displays local OTP only for @iems.local accounts in development.
GMAIL_USER=your-gmail@gmail.com
GMAIL_PASSWORD=your-app-password-here
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_ENCRYPTION=tls
SMTP_FROM_EMAIL=your-gmail@gmail.com
SMTP_FROM_NAME=IEMS Security Team

# Frontend Configuration
# Leave unset: the built frontend calls /api on the same HTTPS domain.
VITE_API_URL=
VITE_APP_NAME=IEMS Dashboard

# Optional: Python Path for AI Models
PYTHON_PATH=python3

# Optional: Logging
LOG_LEVEL=info
